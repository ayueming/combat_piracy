; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "打盗维权系统_试用版"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "HowLittle"
#define MyAppExeName "打盗维权系统_试用版.exe"

[Setup]
; ★ 这个 AppId 千万不要改，它代表了你的软件。以后更新版本，系统靠它识别是升级而不是重新装。
AppId={{BA033BD7-EDFF-4513-9068-66F97E3E1E0E}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
; 默认安装路径
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
DisableProgramGroupPage=yes
; 默认需要管理员权限（安装到 Program Files）
PrivilegesRequired=admin
; 极限压缩
Compression=lzma2
SolidCompression=yes
WizardStyle=modern dynamic

; ★ 新增：指定安装包输出到项目下的 installer_output 文件夹
OutputDir=installer_output
; ★ 新增：安装包的名字，带版本号
OutputBaseFilename=打盗维权系统_安装包_v{#MyAppVersion}

[Languages]
; ★ 新增：支持中文安装界面
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"

[Tasks]
; 默认勾选创建桌面快捷方式
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: checkedonce

[Files]
; ★ 核心：打包 dist 里的所有东西
Source: "E:\combat_piracy\dist\打盗维权系统\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
; 开始菜单和桌面快捷方式
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
; 安装完成后直接运行
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
; ★ 核心保护：卸载时，只删除程序的依赖，绝对不碰 data 文件夹！
; 这里故意不写任何关于 {app}\data 的指令，Inno Setup 就只会删除它自己安装的文件，而 data 是程序后来生成的，不会被卸载器删除。